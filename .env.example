# Copia este archivo como .env y completa con los valores de tu proyecto Supabase
# (Project Settings > API en supabase.com). El .env real NUNCA se sube a git.
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=tu-llave-publishable-o-anon

# OAuth client tipo "Web" de Google Cloud Console (el mismo que registras
# como proveedor Google en Supabase > Authentication > Providers).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=tu-client-id.apps.googleusercontent.com
